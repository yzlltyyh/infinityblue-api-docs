{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "InfinityBlue API",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "default": true,
        "tabs": [
          {
            "tab": "文档",
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "zh/index",
                  "zh/introduction",
                  "zh/quickstart/auth",
                  "zh/quickstart/first-request",
                  "zh/quickstart/errors"
                ]
              },
              {
                "group": "模型（Models）",
                "openapi": {
                  "source": "openapi/models.zh.yaml",
                  "directory": "zh-models"
                },
                "pages": [
                  "GET /v1/models",
                  "GET /v1beta/models"
                ]
              },
              {
                "group": "聊天（Chat）",
                "pages": [
                  {
                    "group": "原生 OpenAI 格式",
                    "openapi": {
                      "source": "openapi/chat.zh.yaml",
                      "directory": "zh-chat"
                    },
                    "pages": [
                      "POST /v1/chat/completions",
                      "POST /v1/responses"
                    ]
                  },
                  {
                    "group": "原生 Gemini 格式",
                    "openapi": {
                      "source": "openapi/chat.zh.yaml",
                      "directory": "zh-chat"
                    },
                    "pages": [
                      "POST /v1beta/models/{model}:generateContent"
                    ]
                  },
                  {
                    "group": "原生 Claude 格式",
                    "openapi": {
                      "source": "openapi/chat.zh.yaml",
                      "directory": "zh-chat"
                    },
                    "pages": [
                      "POST /v1/messages"
                    ]
                  }
                ]
              },
              {
                "group": "图像（Images）",
                "pages": [
                  {
                    "group": "原生 OpenAI 格式",
                    "openapi": {
                      "source": "openapi/images.zh.yaml",
                      "directory": "zh-images"
                    },
                    "pages": [
                      "POST /v1/images/generations",
                      "POST /v1/images/edits"
                    ]
                  },
                  {
                    "group": "Nano Banana",
                    "openapi": {
                      "source": "openapi/images.zh.yaml",
                      "directory": "zh-images"
                    },
                    "pages": [
                      "POST /v1beta/models/{model}:generateContent",
                      "POST /v1/chat/completions"
                    ]
                  }
                ]
              },
              {
                "group": "视频（Videos）",
                "pages": [
                  {
                    "group": "Seedance 异步",
                    "openapi": {
                      "source": "openapi/videos.zh.yaml",
                      "directory": "zh-videos"
                    },
                    "pages": [
                      "POST /v1/videos",
                      "GET /v1/videos/{task_id}",
                      "GET /v1/videos/{task_id}/content"
                    ]
                  },
                  {
                    "group": "通用视频接口",
                    "openapi": {
                      "source": "openapi/videos.zh.yaml",
                      "directory": "zh-videos"
                    },
                    "pages": [
                      "POST /v1/video/generations",
                      "GET /v1/video/generations/{task_id}"
                    ]
                  }
                ]
              },
              {
                "group": "指南",
                "pages": [
                  "zh/guides/model-selection",
                  "zh/guides/streaming",
                  "zh/guides/multimodal-input"
                ]
              }
            ]
          }
        ]
      },
