{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "InfinityBlue API",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "default": true,
        "tabs": [
          {
            "tab": "文档",
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "zh/index",
                  "zh/introduction"
                ]
              },
              {
                "group": "聊天（Chat）",
                "pages": [
                  {
                    "group": "原生 OpenAI 格式",
                    "openapi": "openapi/openapi.zh.yaml",
                    "pages": [
                      "POST /v1/chat/completions"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Get Started",
                "pages": [
                  "index",
                  "introduction"
                ]
              },
              {
                "group": "Chat",
                "pages": [
                  {
                    "group": "OpenAI format",
                    "openapi": "openapi/openapi.en.yaml",
                    "pages": [
                      "POST /v1/chat/completions"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ]
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/yzlltyyh/infinityblue-api-docs"
    }
  }
}
