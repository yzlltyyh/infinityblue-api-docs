{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "InfinityBlue API",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      { "language": "en", "default": true },
      { "language": "zh" }
    ],
    "tabs": [
      {
        "tab": "Documentation",
