          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart/auth",
              "quickstart/first-request",
              "quickstart/errors"
            ]
          },
          {
            "group": "API Reference",
            "pages": [
              "api-reference/chat",
              "api-reference/images",
              "api-reference/videos",
              "api-reference/audio",
              "api-reference/embeddings",
              "api-reference/rerank",
              "api-reference/models"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/model-selection",
              "guides/streaming",
              "guides/multimodal-input"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi/openapi.yaml"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/yzlltyyh/infinityblue-api-docs"
    }
